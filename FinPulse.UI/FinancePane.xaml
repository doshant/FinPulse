<UserControl x:Class="FinPulse.UI.FinancePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="280"
             Background="#F5F7FB">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <TextBlock Text="FINANCE EXPLORER"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#52709A"/>

            <TextBlock Text="Financial performance"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Foreground="#172B4D"
                       Margin="0,8,0,4"/>

            <TextBlock
                Text="Explore your bank's monthly and quarterly results."
                TextWrapping="Wrap"
                Foreground="#667085"
                Margin="0,0,0,20"/>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="14"
                    BorderBrush="#E1E7F0"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="DASHBOARD STATUS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#667085"/>

                    <TextBlock Text="Your workspace is ready."
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#172B4D"
                               Margin="0,8,0,4"/>

                    <TextBlock
                        Text="Next, we'll connect the financial data and interactive filters."
                        TextWrapping="Wrap"
                        Foreground="#667085"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
